{% macro circleText(text, id) %}
<svg class="[ circle-text ] [ box-hidden md:box-block ]" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 500 500">
  <defs>
    <path d="M50,250c0-110.5,89.5-200,200-200s200,89.5,200,200s-89.5,200-200,200S50,360.5,50,250" id="{{ id }}">
    </path>
  </defs>
  <text textLength="1220">
    <textPath xlink:href="#{{ id }}">{{ text }}</textPath>
  </text>
</svg>
{% endmacro %}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% include "partials/meta-info.njk" %}

    <link rel="preload" href="/fonts/MaisonNeue-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Roboto_Mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="{{ '/css/global.css' | assetUrl }}" />

    {# Add facility for pages to declare an array of stylesheet paths #}
    {% if pageStylesheets %}
      {% for item in pageStylesheets %}
        <link rel="stylesheet" href="{{ item | assetUrl }}" />
      {% endfor %}
    {% endif %}

    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icons/favicon-16x16.png">
    <link rel="manifest" href="/images/icons/site.webmanifest">
    <link rel="mask-icon" href="/images/icons/safari-pinned-tab.svg" color="#00ff19">
    <link rel="shortcut icon" href="/images/icons/favicon.ico">
    <meta name="msapplication-TileColor" content="#00ff19">
    <meta name="msapplication-config" content="/images/icons/browserconfig.xml">
    <meta name="theme-color" content="#00ff19">

  </head>
  <body class="{{ bodyTokens }}">
    {% include "partials/site-head.njk" %}

    <main tabindex="-1" id="main-content">
      {% block content %}{% endblock %}
    </main>

    {% include "partials/site-foot.njk" %}
    <script src="{{ '/js/audio-player.js' | assetUrl }}" type="module"></script>
    <script src="{{ '/js/burger-menu.js' | assetUrl }}" type="module"></script>

    {# Add facility for pages to declare an array of script paths #}
    {% if pageScripts %}
      {% for item in pageScripts %}
        <script src="{{ item | assetUrl }}" type="module"></script>
      {% endfor %}
    {% endif %}

  </body>
</html>
